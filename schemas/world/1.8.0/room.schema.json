{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventure-chat.local/schemas/world/1.8.0/room.schema.json",
  "title": "RoomDefinition",
  "description": "Schema for Adventure Chat room YAML authoring format",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "background",
    "size",
    "spawns",
    "walkable"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Room format specification version (must be 1)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Stable unique identifier for the room"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name of the room"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to PNG background image file"
    },
    "size": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical pixel width (e.g. 640)"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical pixel height (e.g. 360)"
        }
      },
      "additionalProperties": false
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "position"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique spawn identifier within the room"
          },
          "position": {
            "$ref": "#/$defs/point"
          }
        },
        "additionalProperties": false
      }
    },
    "walkable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Walkable area identifier"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "points"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Obstacle polygon identifier"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Exit identifier"
          },
          "position": {
            "$ref": "#/$defs/point"
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "description": "Trigger/interaction radius in logical pixels"
          },
          "bounds": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "minimum": 1
              },
              "height": {
                "type": "number",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "description": "Optional human-readable exit label (e.g. for SCUMM action bar)"
          },
          "target": {
            "type": "object",
            "required": [
              "room",
              "spawn"
            ],
            "properties": {
              "room": {
                "type": "string",
                "description": "Target room identifier"
              },
              "spawn": {
                "type": "string",
                "description": "Target spawn point identifier"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "description": "Authoring notes and comments preserved across edits"
    },
    "perspective": {
      "enum": [
        "adventure",
        "top-down"
      ]
    },
    "actorHeight": {
      "type": "number",
      "minimum": 16,
      "maximum": 128
    },
    "walkSpeed": {
      "type": "number",
      "minimum": 1,
      "maximum": 1000
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "scrollMode"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "scrollMode": {
          "const": "horizontal"
        }
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "image",
          "position",
          "size",
          "depthY"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "image": {
            "type": "string",
            "pattern": "^assets/images/.+\\.[pP][nN][gG]$"
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "size": {
            "$ref": "#/properties/size"
          },
          "depthY": {
            "type": "integer",
            "minimum": 0
          },
          "interaction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "initialState",
              "useRadius",
              "states",
              "actions"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "initialState": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "usePoint": {
                "$ref": "#/$defs/point"
              },
              "useRadius": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 200
              },
              "states": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "image",
                    "position",
                    "size",
                    "depthY"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "image": {
                      "type": "string",
                      "pattern": "^assets/images/.+\\.[pP][nN][gG]$"
                    },
                    "position": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "x",
                        "y"
                      ],
                      "properties": {
                        "x": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "y": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "size": {
                      "$ref": "#/properties/size"
                    },
                    "depthY": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "obstacles": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "points"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                          },
                          "points": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 16,
                            "items": {
                              "$ref": "#/$defs/point"
                            }
                          }
                        }
                      }
                    },
                    "blockedExits": {
                      "type": "array",
                      "maxItems": 32,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                      }
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "from",
                    "to"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "from": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "effects": {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "room",
                          "object",
                          "state"
                        ],
                        "properties": {
                          "room": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                          },
                          "object": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                          },
                          "state": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "usePoints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "interaction"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "usePoints"
                  ]
                },
                {
                  "properties": {
                    "interaction": {
                      "required": [
                        "usePoint"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "depthScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "back",
        "front"
      ],
      "properties": {
        "back": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "y",
            "factor"
          ],
          "properties": {
            "y": {
              "type": "number",
              "minimum": 0
            },
            "factor": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 2
            }
          }
        },
        "front": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "y",
            "factor"
          ],
          "properties": {
            "y": {
              "type": "number",
              "minimum": 0
            },
            "factor": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 2
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  }
}
