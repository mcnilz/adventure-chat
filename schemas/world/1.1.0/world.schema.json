{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventure-chat.local/schemas/world/1.1.0/world.schema.json",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "name",
    "contentVersion",
    "startRoom",
    "startSpawn",
    "roomFormat"
  ],
  "properties": {
    "formatVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "contentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "startRoom": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "startSpawn": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "roomFormat": {
      "const": "legacy-1"
    }
  },
  "additionalProperties": false
}
