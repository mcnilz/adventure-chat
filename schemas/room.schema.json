{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adventure-chat.local/schemas/room.schema.json",
  "title": "RoomDefinition",
  "description": "Schema for Adventure Chat room YAML authoring format",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "background",
    "size",
    "spawns",
    "walkable"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Room format specification version (must be 1)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "description": "Stable unique identifier for the room"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable display name of the room"
    },
    "background": {
      "type": "string",
      "minLength": 1,
      "description": "Relative path to PNG background image file"
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical pixel width (e.g. 640)"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Logical pixel height (e.g. 360)"
        }
      },
      "additionalProperties": false
    },
    "spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "position"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Unique spawn identifier within the room"
          },
          "position": {
            "$ref": "#/$defs/point"
          }
        },
        "additionalProperties": false
      }
    },
    "walkable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "points"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Walkable area identifier"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "points"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Obstacle polygon identifier"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/point"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "exits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "position", "target"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "Exit identifier"
          },
          "position": {
            "$ref": "#/$defs/point"
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "description": "Trigger/interaction radius in logical pixels"
          },
          "bounds": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 1 },
              "height": { "type": "number", "minimum": 1 }
            },
            "additionalProperties": false
          },
          "label": {
            "type": "string",
            "description": "Optional human-readable exit label (e.g. for SCUMM action bar)"
          },
          "target": {
            "type": "object",
            "required": ["room", "spawn"],
            "properties": {
              "room": {
                "type": "string",
                "description": "Target room identifier"
              },
              "spawn": {
                "type": "string",
                "description": "Target spawn point identifier"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "description": "Authoring notes and comments preserved across edits"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
